{
  "name": "rental-agreement-creator",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "dev:wrangler": "wrangler dev",
    "build": "next build --webpack",
    "build:open": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy --keep-vars",
    "test": "vitest",
    "test:ci": "vitest --reporter verbose --coverage --maxWorkers=2 --maxConcurrency=2",
    "lint": "eslint",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pre:preview": "npm run build:open",
    "pre:dev:wrangler": "npm run build:open",
    "pre:deploy": "npm run build:open",
    "clean": "rimraf .next .wrangler node_modules out tsconfig.tsbuildinfo next-env.d.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.42.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@mui/x-date-pickers": "^8.23.0",
    "@opennextjs/cloudflare": "^1.19.11",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "jspdf": "^4.2.1",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/expect": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.102.0"
  }
}
